{
  "name": "cbo-qbq-site",
  "version": "0.1.0",
  "private": true,
  "description": "API REST, servidor MCP e site da Classificação Brasileira de Ocupações (CBO) e do Quadro Brasileiro de Qualificações (QBQ), somente leitura, a partir do cbo-qbq-dados.",
  "license": "MIT",
  "author": {
    "name": "Wil Fernandes",
    "url": "https://orcid.org/0009-0008-3477-5521"
  },
  "homepage": "https://cbo.ciencia.social",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ciencia-social/cbo-qbq-site.git"
  },
  "bugs": {
    "url": "https://github.com/ciencia-social/cbo-qbq-site/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dados": "node --experimental-strip-types scripts/construir-banco.ts --force",
    "prebuild": "node --experimental-strip-types scripts/construir-banco.ts",
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "pretest": "node --experimental-strip-types scripts/construir-banco.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mcp": "tsx src/mcp/stdio.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.1.1"
  }
}
